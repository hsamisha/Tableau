              <image-path>C:/Users/hsami/AppData/Local/Temp/TableauTemp/0aoldzg0wv38461c3j3mn1ir6yuo/Sheets16/Image/4444.jpeg</image-path>
            </button-visual-state>
          </button>
        </zone>
        <zone forceUpdate='true' h='7885' id='46' type-v2='text' w='82866' x='13185' y='9080'>
          <formatted-text>
            <run bold='true' fontcolor='#0000ff' fontname='Benton Sans Book' fontsize='16'>Project Summary — Google Play Store Analytics using Tableau:</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='36918' id='47' type-v2='text' w='84140' x='13376' y='15651'>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>This project focuses on analyzing the </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Google Play Store dataset using Tableau</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> to understand app performance, user engagement, ratings, installations, pricing, app size, content ratings, and Android version compatibility. The data was cleaned and transformed to create meaningful visualizations and KPIs.</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>An interactive Tableau dashboard was developed with multiple sections, including </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Executive Overview, App Performance, and Pricing &amp; App Size</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>. The dashboards contain KPIs and charts such as </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Total Apps, Total Installs, Average Rating, Apps by Category, Top Apps by Installs, Reviews vs Installs, Reviews vs Rating, Free vs Paid Apps, Apps by Content Rating, Average Rating by Type, Apps by Android Version, and App Size analysis</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>The project helps identify </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>patterns in app popularity, ratings, reviews, installations, pricing, and app characteristics</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>, providing an interactive way to explore Google Play Store app data and support data-driven insights.</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='20789' id='48' type-v2='text' w='19490' x='13503' y='51135'>
          <formatted-text>
            <run bold='true' fontcolor='#0000ff' fontname='Benton Sans Book' fontsize='14'>Key Tools:</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>   • Tableau</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>   • Excel / CSV</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>   • Data Visualization</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>   • Data Cleaning &amp; Analysis</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='14815' id='49' type-v2='text' w='78662' x='13439' y='72879'>
